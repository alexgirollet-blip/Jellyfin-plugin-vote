<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JellyfinTarget selects the server line this build is for.
    10.11 (default): net9.0 + Jellyfin.Controller 10.11.10. Jellyfin removes public members
    between patch releases (10.11.10 dropped IUserManager.Users), so the package version must
    equal build.yaml targetAbi; CI checks this and JIT-verifies the DLL against that version.
    A Jellyfin 12 build can later be produced with -p:JellyfinTarget=12 once tested.
  -->
  <PropertyGroup>
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">10.11</JellyfinTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinTarget)' == '10.11'">
    <TargetFramework>net9.0</TargetFramework>
    <JellyfinPackageVersion>10.11.10</JellyfinPackageVersion>
    <DefineConstants>$(DefineConstants);JELLYFIN_10_11</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinTarget)' == '12'">
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinPackageVersion>12.1.0</JellyfinPackageVersion>
    <DefineConstants>$(DefineConstants);JELLYFIN_12</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.MediaVote</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackageVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackageVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\*.html" />
    <None Remove="Assets\*" />
    <EmbeddedResource Include="Configuration\*.html" />
    <EmbeddedResource Include="Assets\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.MediaVote.Tests" />
  </ItemGroup>

</Project>
